# .omc: explicitly ignore ephemeral dirs, persistent artifacts tracked by default
# Using **/.omc/<dir> patterns covers both root and nested .omc/ dirs.
# Trade-off: must update this list if new ephemeral dirs are added to .omc/
**/.omc/state/
**/.omc/sessions/
**/.omc/autopilot/
**/.omc/drafts/
**/.omc/handoffs/
**/.omc/telemetry/
**/.omc/self-improve/
**/.omc/logs/
**/.omc/prd*.json
**/.omc/progress.txt
.worktrees/
.claude/backups/

.agent_key
# Local dev config (OpenBao + Dex), generated by shellHook on nix develop
.dev/
.cargo/

# Crash artifacts and local logs. A core dump is process memory: never commit
# one, and never let `git add -A` be able to.
core.*
*.log

# OMC run state that escaped the **/.omc/ patterns above (a bare .omo/ typo dir
# has appeared here before).
/.omo/

# Local KB build artifacts. The tracked KB lives on the agentic branch under
# agent-kb/; this ignores the build stamp and sqlite side-files that master
# picks up when the tooling runs from a master checkout.
/agent-kb/
agent-kb.db.tmp*
agent-kb.db.pre-v*.bak

# TLC model-checker output. 4013 blobs / 2.4 GB of these reached the agentic
# branch's history once and had to be removed with filter-repo; the working
# trees were already clean, so nothing but .gitignore prevents a repeat.
agent-kb/tla/states/
